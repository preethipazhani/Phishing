{
  "manifest_version": 3,
  "name": "PhishGuard local",
  "version": "1.0",
  "description": "Real-time Machine Learning Phishing Detection",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ]
}
